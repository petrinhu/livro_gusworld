#!/bin/sh
# Portao de pre-push do livro (SG-02). A entrada do git e lida uma vez, salva em arquivo e entregue
# ao portao e ao hook global de mesmo nome. O que o remoto ja tem vem do proprio remoto (git ls-remote
# no endereco do envio), nunca de refs/remotes locais (SG-02f). O portao julgado e o do main publicado
# no remoto. Remoto com qualquer ref e sem main, ou com main que nao existe aqui: o envio fecha.
# Remoto sem nenhuma ref: so com PORTOES_PRIMEIRO_ENVIO igual ao commit enviado ao main (SG-02g).
# Endereco que e nome de remoto, ou reescrita de endereco (insteadOf) na config: o envio fecha.
AQUI=$(cd "$(dirname "$0")" && pwd) || exit 1
. "$AQUI/confiavel.sh" || exit 1
confere_instalacao pre-push "$AQUI" || exit 1
PUB_ARQ=
CRU=
trap 'limpa_temporarios; [ -z "$PUB_ARQ" ] || rm -f "$PUB_ARQ"; [ -z "$CRU" ] || rm -f "$CRU"' EXIT
ENT=$(mktemp "${TMPDIR:-/var/tmp}/portoes-ent.XXXXXX") || exit 1
cat > "$ENT" || exit 1
git config --name-only --get-regexp '^url\..*\.(push)?insteadof$' > /dev/null 2>&1
rc=$?
if [ "$rc" -ne 1 ]; then
    echo "  FALHOU reescrita de endereco na config (url.*.insteadOf): o envio fecha"
    exit 1
fi
if git remote | grep -qxF -- "$2"; then
    echo "  FALHOU endereco do envio igual a nome de remoto: $2"
    exit 1
fi
PUB_ARQ=$(mktemp "${TMPDIR:-/var/tmp}/portoes-pub.XXXXXX") || exit 1
CRU=$(mktemp "${TMPDIR:-/var/tmp}/portoes-cru.XXXXXX") || exit 1
if [ -z "$2" ] || ! git ls-remote --refs -- "$2" > "$CRU"; then
    rm -f "$CRU"
    echo "  FALHOU remoto ilegivel: git ls-remote no endereco do envio"
    exit 1
fi
awk -F '\t' '$2 ~ /^refs\/(heads|tags)\//' "$CRU" > "$PUB_ARQ" || exit 1
if [ -s "$CRU" ]; then
    PUB=$(awk -F '\t' '$2 == "refs/heads/main" {print $1}' "$PUB_ARQ")
    if [ -z "$PUB" ] || ! git cat-file -e "$PUB^{commit}" 2>/dev/null; then
        echo "  FALHOU main publicado ausente aqui: rode git fetch antes do envio"
        exit 1
    fi
    REV=$PUB
else
    PUB=$(awk '$3 == "refs/heads/main" {print $2}' "$ENT")
    if [ -z "$PUB" ] || [ "${PORTOES_PRIMEIRO_ENVIO:-}" != "$PUB" ]; then
        echo "  FALHOU remoto vazio: o primeiro envio pede PORTOES_PRIMEIRO_ENVIO igual ao commit enviado ao main"
        exit 1
    fi
    REV=$PUB
fi
rm -f "$CRU"
extrai_portao "$REV" || exit 1
PORTOES_PUBLICADOS="$PUB_ARQ"; export PORTOES_PUBLICADOS
roda_portao envio < "$ENT" || exit 1
GLOBAL="${HOME:-/nonexistent}/.claude/githooks/pre-push"
if [ -x "$GLOBAL" ]; then
    "$GLOBAL" "$@" < "$ENT"
    rc=$?
    [ "$rc" -eq 0 ] || exit "$rc"
fi
exit 0
