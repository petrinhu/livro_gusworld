#!/bin/sh
# Portao de pre-push do livro (SG-02). A entrada do git e lida uma vez, salva em arquivo e entregue
# ao portao e ao hook global de mesmo nome. O que o remoto ja tem vem do proprio remoto (git ls-remote
# no endereco do envio), nunca de refs/remotes locais (SG-02f). O portao julgado e o do main publicado
# no remoto; remoto vazio (primeiro envio): o do HEAD; remoto com refs e sem main, ou main que nao
# existe aqui: o envio fecha.
AQUI=$(cd "$(dirname "$0")" && pwd) || exit 1
. "$AQUI/confiavel.sh" || exit 1
confere_instalacao pre-push "$AQUI" || exit 1
PUB_ARQ=
trap 'limpa_temporarios; [ -z "$PUB_ARQ" ] || rm -f "$PUB_ARQ"' EXIT
ENT=$(mktemp "${TMPDIR:-/var/tmp}/portoes-ent.XXXXXX") || exit 1
cat > "$ENT" || exit 1
PUB_ARQ=$(mktemp "${TMPDIR:-/var/tmp}/portoes-pub.XXXXXX") || exit 1
if [ -z "$2" ] || ! git ls-remote --refs "$2" > "$PUB_ARQ.cru"; then
    rm -f "$PUB_ARQ.cru"
    echo "  FALHOU remoto ilegivel: git ls-remote no endereco do envio"
    exit 1
fi
awk -F '\t' '$2 ~ /^refs\/(heads|tags)\//' "$PUB_ARQ.cru" > "$PUB_ARQ" || exit 1
rm -f "$PUB_ARQ.cru"
REV=HEAD
if [ -s "$PUB_ARQ" ]; then
    PUB=$(awk -F '\t' '$2 == "refs/heads/main" {print $1}' "$PUB_ARQ")
    if [ -z "$PUB" ] || ! git cat-file -e "$PUB^{commit}" 2>/dev/null; then
        echo "  FALHOU main publicado ausente aqui: rode git fetch antes do envio"
        exit 1
    fi
    REV=$PUB
fi
extrai_portao "$REV" || exit 1
PORTOES_PUBLICADOS="$PUB_ARQ"; export PORTOES_PUBLICADOS
roda_portao envio < "$ENT" || exit 1
GLOBAL="${HOME:-/nonexistent}/.claude/githooks/pre-push"
if [ -x "$GLOBAL" ]; then
    "$GLOBAL" "$@" < "$ENT"
    rc=$?
    [ "$rc" -eq 0 ] || exit "$rc"
fi
exit 0
