#!/bin/sh
# Portao de pre-commit do livro (SG-02). Roda o portao deste repositorio e depois
# o hook global de mesmo nome, porque core.hooksPath local sombreia o global.
DIR=$(cd "$(dirname "$0")" && pwd) || exit 1
python3 "$DIR/portoes.py" pre-commit || exit 1
GLOBAL="${HOME:-/nonexistent}/.claude/githooks/pre-commit"
if [ -x "$GLOBAL" ]; then
    "$GLOBAL" "$@"
    rc=$?
    [ "$rc" -eq 0 ] || exit "$rc"
fi
exit 0
