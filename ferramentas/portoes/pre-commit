#!/bin/sh
# Portao de pre-commit do livro (SG-02). Julga o commit pelo portao do HEAD, nunca pela arvore de trabalho.
# Depois roda o hook global de mesmo nome, porque core.hooksPath local sombreia o global.
AQUI=$(cd "$(dirname "$0")" && pwd) || exit 1
. "$AQUI/confiavel.sh" || exit 1
confere_instalacao pre-commit "$AQUI" || exit 1
extrai_portao HEAD || exit 1
python3 -I "$PORTAO_DIR/portoes.py" pre-commit || exit 1
GLOBAL="${HOME:-/nonexistent}/.claude/githooks/pre-commit"
if [ -x "$GLOBAL" ]; then
    "$GLOBAL" "$@"
    rc=$?
    [ "$rc" -eq 0 ] || exit "$rc"
fi
exit 0
